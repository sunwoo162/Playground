{
  "name": "playground",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "BloomBouquet project gallery, shared bouquet SSO, and senior-Agent evaluation platform",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:bloom-web\"",
    "dev:server": "node server/index.js",
    "dev:client": "pnpm run dev:bloom-web",
    "dev:bloom-web": "vite bloom-web",
    "build": "pnpm run build:bloom-web",
    "build:bloom-web": "pnpm exec tsc -p bloom-web/tsconfig.json --noEmit && vite build bloom-web --outDir ../dist --emptyOutDir",
    "build:web": "pnpm run build:bloom-web",
    "test:bloom-runtime": "node -e \"require('fs').rmSync('.tmp/bloom-policy-tests',{recursive:true,force:true})\" && pnpm --dir apps/desktop exec tsc -p ../../bloom-runtime/tsconfig.policy-tests.json && node bloom-runtime/run-policy-tests.cjs",
    "test:production-runtime": "node --test scripts/production-runtime.policy-test.js scripts/luna-automatic-delivery.production-policy-test.js bloom-worker/run.policy-test.js scripts/bloom-management.policy-test.js scripts/bloombouquet-ui.policy-test.js scripts/bloombouquet-domain.policy-test.js scripts/bloombouquet-server-path.policy-test.js scripts/bloombouquet-app-gateway.policy-test.js scripts/bloom-live-e2e-workflow.policy-test.js",
    "build:bloom-worker": "pnpm --dir apps/desktop exec tsc -p ../../bloom-runtime/tsconfig.worker.json && node --check bloom-worker/run.js",
    "build:bloom-runtime-bridge": "cargo build --manifest-path bloom-runtime/Cargo.toml --bin bloom-runtime-bridge --release",
    "start:bloom-worker": "pnpm run build:bloom-worker && node bloom-worker/run.js",
    "install:apps": "pnpm install",
    "install:all": "pnpm install --frozen-lockfile",
    "build:all": "pnpm run build:bloom-web",
    "harness": "node scripts/harness-check.js",
    "verify": "pnpm run build:bloom-web && pnpm run harness",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "jsonwebtoken": "^9.0.3",
    "web-push": "^3.6.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "typescript": "~5.7.0",
    "vite": "^6.2.0"
  }
}
