{
  "manifest_version": 3,
  "name": "Voice Studio",
  "description": "Open the Voice Studio real-time voice panel from Chrome.",
  "version": "0.1.0",
  "action": {
    "default_title": "Voice Studio",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "permissions": ["tabs"],
  "host_permissions": ["https://playground.https.gsmsv.site/*"]
}
