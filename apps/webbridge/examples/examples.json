[
  {
    "id": "example-extract-webhook",
    "name": "예제: 현재 페이지 내용을 웹훅으로 보내기",
    "description": "현재 페이지의 제목과 URL을 읽어 웹훅으로 보냅니다. URL을 본인 웹훅으로 바꿔 사용하세요.",
    "enabled": false,
    "trigger": { "type": "manual" },
    "steps": [
      {
        "type": "extract",
        "fields": {
          "title": "h1",
          "url": { "selector": "link[rel=canonical]", "attr": "href" }
        }
      },
      {
        "type": "transform",
        "script": "return { ...data, url: data.url || context.url, at: new Date().toISOString() };"
      },
      {
        "type": "http",
        "url": "https://hooks.example.com/replace-me",
        "method": "POST",
        "headers": { "Content-Type": "application/json" },
        "body": "{{JSON.stringify(data)}}"
      },
      { "type": "notify", "title": "WebBridge", "message": "전송 완료: {{data.title}}" }
    ]
  },
  {
    "id": "example-cross-site-form",
    "name": "예제: 현재 페이지 값으로 다른 사이트 폼 채우기",
    "description": "현재 페이지에서 이름/메모 같은 값을 읽고 다른 사이트의 폼을 새 탭에 열어 자동 입력합니다.",
    "enabled": false,
    "trigger": { "type": "manual" },
    "steps": [
      {
        "type": "extract",
        "fields": { "name": "h1", "note": ".description" }
      },
      {
        "type": "automate",
        "tab": "new",
        "url": "https://target-site.example.com/form",
        "steps": [
          { "type": "wait", "selector": "#name", "timeout": 10000 },
          { "type": "input", "selector": "#name", "value": "{{data.name}}" },
          { "type": "input", "selector": "#note", "value": "{{data.note}}" },
          { "type": "click", "selector": "#submit" },
          { "type": "wait", "ms": 1500 },
          { "type": "extract", "fields": { "result": ".confirmation" } }
        ]
      },
      { "type": "notify", "title": "자동 입력 완료", "message": "결과: {{data.result}}" }
    ]
  },
  {
    "id": "example-scrape-list",
    "name": "예제: 목록을 긁어서 저장하기",
    "description": "페이지 로드 시 상품, 게시글, 주문 같은 목록을 긁어 확장 저장소에 저장합니다.",
    "enabled": false,
    "trigger": { "type": "page-load", "urlPattern": "*://*.example.com/list*" },
    "steps": [
      {
        "type": "extract",
        "fields": {
          "items": { "selector": ".item .title", "multiple": true }
        }
      },
      {
        "type": "transform",
        "script": "return { count: (data.items||[]).length, items: data.items, scrapedAt: Date.now() };"
      },
      { "type": "store", "key": "scrapedItems" },
      { "type": "notify", "title": "스크랩", "message": "{{data.count}}건 저장됨" }
    ]
  },
  {
    "id": "example-interval-check",
    "name": "예제: 주기적으로 상태 확인하고 알림 받기",
    "description": "주기적으로 활성 탭을 검사해 원하는 상태가 보이면 알림을 띄웁니다. (활성 탭에서 동작)",
    "enabled": false,
    "trigger": { "type": "interval", "intervalMinutes": 10 },
    "steps": [
      {
        "type": "extract",
        "fields": { "status": ".status-badge" }
      },
      {
        "type": "if",
        "condition": "data.status && data.status.includes('완료')",
        "then": [
          { "type": "notify", "title": "상태 변경", "message": "완료됨: {{data.status}}" }
        ]
      }
    ]
  }
]
