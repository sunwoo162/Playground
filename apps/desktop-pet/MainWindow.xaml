<Window x:Class="PlaygroundDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Playground Desktop Pet"
        Width="360" Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="SpeechBubble"
                Visibility="Collapsed"
                Margin="8,8,8,0"
                Padding="16,12"
                CornerRadius="8"
                BorderThickness="2"
                BorderBrush="#70FF48"
                Background="#E9000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="> SYSTEM"
                           Foreground="#70FF48"
                           FontFamily="Consolas"
                           FontSize="15"/>
                <TextBlock x:Name="SpeechText"
                           Grid.Row="1"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="#70FF48"
                           FontFamily="Consolas"
                           FontSize="18"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MouseLeftButtonDown="Pet_MouseLeftButtonDown" MouseLeftButtonUp="Pet_MouseLeftButtonUp" MouseMove="Pet_MouseMove" MouseRightButtonUp="Pet_MouseRightButtonUp">
            <Image x:Name="PetImage"
                   Width="220"
                   Height="220"
                   Stretch="Uniform"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Visibility="Collapsed"/>

            <Border x:Name="FallbackPet"
                    Width="185" Height="185"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    CornerRadius="92"
                    Background="#F4F8FF"
                    BorderBrush="#83B9FF"
                    BorderThickness="4">
                <Grid>
                    <TextBlock x:Name="FallbackFace"
                               Text="•ᴗ•"
                               FontSize="52"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#182238"/>
                    <TextBlock x:Name="FallbackLabel"
                               Text="Luna"
                               Margin="0,0,0,28"
                               FontWeight="SemiBold"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Foreground="#4A79B9"/>
                </Grid>
            </Border>

            <Border x:Name="CommandPanel"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    Margin="12,0,12,6"
                    Padding="12"
                    CornerRadius="8"
                    Background="#F5000000"
                    BorderBrush="#70FF48"
                    BorderThickness="2">
                <StackPanel>
                    <TextBlock Text="> COMMAND" Foreground="#70FF48" FontFamily="Consolas" FontSize="14"/>
                    <TextBox x:Name="CommandInput"
                             Margin="0,8,0,6"
                             FontFamily="Consolas"
                             FontSize="18"
                             Background="#0B0B0B"
                             Foreground="#70FF48"
                             BorderBrush="#70FF48"
                             CaretBrush="#70FF48"
                             TextChanged="CommandInput_TextChanged"
                             KeyDown="CommandInput_KeyDown"/>
                    <ListBox x:Name="CommandList"
                             MaxHeight="150"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#70FF48"
                             FontFamily="Consolas"
                             FontSize="15"
                             MouseDoubleClick="CommandList_MouseDoubleClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
