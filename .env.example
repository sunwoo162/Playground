# GitHub OAuth App 설정
# https://github.com/settings/developers 에서 OAuth App 생성 후 입력
GITHUB_CLIENT_ID=여기에_클라이언트_ID
GITHUB_CLIENT_SECRET=여기에_클라이언트_시크릿

# 세션 암호화 키 (아무 랜덤 문자열)
SESSION_SECRET=your-random-secret-key-here

# Node/Spring이 공유하는 JWT 서명 키
JWT_SECRET=replace-with-at-least-32-random-characters

# Bloom headless worker가 Builder backend protocol에 인증할 때 사용하는 전용 토큰
# 사용자 JWT와 분리하며 32자 이상의 랜덤 비밀값을 사용합니다.
BUILDER_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Bloom headless worker Runtime 설정
BLOOM_API_BASE_URL=http://localhost:8080
BLOOM_GITHUB_ORGANIZATION=your-github-organization
BLOOM_WORKSPACE_ROOT=/srv/bloom-workspaces
BLOOM_WORKER_ID=bloom-host-01
BLOOM_TEAM_ID=rose
BLOOM_TEAM_NAME=Rose
# 비우면 bloom-runtime/target/release/bloom-runtime-bridge(.exe)를 사용합니다.
BLOOM_RUNTIME_BRIDGE_PATH=
BLOOM_WORKER_POLL_INTERVAL_MS=5000
BLOOM_WORKER_HEARTBEAT_INTERVAL_MS=30000

# Bloom 무료 Local LLM Runtime
# 기본 모델: Qwen2.5-Coder-1.5B-Instruct GGUF Q4_K_M / llama.cpp
# Local model server는 127.0.0.1에만 bind하고 외부에 노출하지 않습니다.
BLOOM_LOCAL_LLM_URL=http://127.0.0.1:8091/v1/chat/completions
BLOOM_LOCAL_LLM_MODEL=qwen2.5-coder-1.5b-instruct
BLOOM_LOCAL_LLM_HF_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct-GGUF
BLOOM_LOCAL_LLM_QUANT=Q4_K_M
BLOOM_LOCAL_LLM_PORT=8091
BLOOM_LOCAL_LLM_CONTEXT=8192
BLOOM_LOCAL_LLM_MAX_TOKENS=3072
BLOOM_LOCAL_AGENT_MAX_TOKENS=1536
BLOOM_LOCAL_MAX_TOOL_TURNS=24
# 서버 보호: 전체 Local Agent session은 lock으로 1개씩만 실행합니다.
BLOOM_LOCAL_MAX_MEMORY_RATIO=0.88
BLOOM_LOCAL_MAX_LOAD_PER_CPU=1.0
BLOOM_LOCAL_RESOURCE_POLL_MS=3000
BLOOM_LOCAL_RESOURCE_MAX_WAIT_MS=900000

# 서버 포트
PORT=3000

# 콜백 URL
# GitHub OAuth App의 Authorization callback URL과 완전히 같아야 합니다.
# 현재 Playground Node OAuth 배포용:
# CALLBACK_URL=http://ssh.gsmsv.site:30234/auth/github/callback
# 로컬 Node OAuth App을 따로 만든 경우:
CALLBACK_URL=http://localhost:3000/auth/github/callback

# 나이스 급식 API
NEIS_API_KEY=여기에_나이스_API_키

# 하차 알람: 서울 열린데이터 지하철 API
# https://data.seoul.go.kr 에서 발급
SEOUL_OPEN_API_KEY=여기에_서울_열린데이터_API_키

# 하차 알람: 서울 버스 도착/정류장 API
# https://www.data.go.kr 의 서울특별시 버스정보 API serviceKey
SEOUL_BUS_API_KEY=여기에_서울_버스_API_SERVICE_KEY

# Twelve Data API
# 실제 키는 커밋하지 말고 서버 환경변수/시크릿에만 설정
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_API_KEY=여기에_TWELVE_DATA_API_KEY
TWELVE_DATA_MOCK=false
