# GitHub OAuth App 설정
# https://github.com/settings/developers 에서 OAuth App 생성 후 입력
GITHUB_CLIENT_ID=여기에_클라이언트_ID
GITHUB_CLIENT_SECRET=여기에_클라이언트_시크릿

# 세션 암호화 키 (아무 랜덤 문자열)
SESSION_SECRET=your-random-secret-key-here

# Node/Spring이 공유하는 JWT 서명 키
JWT_SECRET=replace-with-at-least-32-random-characters

# Builder headless worker 전용 인증 토큰
# 사용자 JWT와 분리하며 32자 이상의 랜덤 비밀값을 사용합니다.
BUILDER_WORKER_TOKEN=replace-with-at-least-32-random-characters

# Builder headless worker Runtime 설정
BUILDER_API_BASE_URL=http://localhost:8080
BUILDER_GITHUB_ORGANIZATION=your-github-organization
BUILDER_WORKSPACE_ROOT=/srv/builder-workspaces
BUILDER_WORKER_ID=builder-host-01
BUILDER_TEAM_ID=rose
BUILDER_TEAM_NAME=Rose
# 비우면 apps/desktop/src-tauri/target/release/builder-runtime-bridge(.exe)를 사용합니다.
BUILDER_RUNTIME_BRIDGE_PATH=
BUILDER_WORKER_POLL_INTERVAL_MS=5000
BUILDER_WORKER_HEARTBEAT_INTERVAL_MS=30000

# 서버 포트
PORT=3000

# 콜백 URL
# GitHub OAuth App의 Authorization callback URL과 완전히 같아야 합니다.
# 현재 Playground Node OAuth 배포용:
# CALLBACK_URL=http://ssh.gsmsv.site:30234/auth/github/callback
# 로컬 Node OAuth App을 따로 만든 경우:
CALLBACK_URL=http://localhost:3000/auth/github/callback

# 나이스 급식 API
NEIS_API_KEY=여기에_나이스_API_키

# 하차 알람: 서울 열린데이터 지하철 API
# https://data.seoul.go.kr 에서 발급
SEOUL_OPEN_API_KEY=여기에_서울_열린데이터_API_키

# 하차 알람: 서울 버스 도착/정류장 API
# https://www.data.go.kr 의 서울특별시 버스정보 API serviceKey
SEOUL_BUS_API_KEY=여기에_서울_버스_API_SERVICE_KEY

# Twelve Data API
# 실제 키는 커밋하지 말고 서버 환경변수/시크릿에만 설정
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_API_KEY=여기에_TWELVE_DATA_API_KEY
TWELVE_DATA_MOCK=false
