# Evidence Vault application
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_vault
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Shared 꽃다발 Identity Provider
BOUQUET_BASE_URL=http://localhost:8080
BOUQUET_CLIENT_ID=evidence-vault-local
BOUQUET_REDIRECT_URI=http://localhost:3000/auth/bouquet/callback

# Private evidence storage. Use STORAGE_DRIVER=local only for local development.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.data/evidence
S3_ENDPOINT=
S3_REGION=ap-northeast-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
